{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nookbridge.local/schemas/linux-release-manifest.schema.json",
  "title": "NookBridge Linux release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactFormat",
    "buildTimestamp",
    "dirtyTree",
    "gitCommit",
    "minGlibc",
    "minLibstdcxx",
    "node",
    "packageLockSha256",
    "payloadInventorySha256",
    "stateCompatibility",
    "target",
    "version"
  ],
  "properties": {
    "artifactFormat": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "dirtyTree": {
      "const": false
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "libc"],
      "properties": {
        "os": { "const": "linux" },
        "arch": { "const": "x86_64" },
        "libc": { "const": "glibc" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "abi"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^22\\.23\\.2$"
        },
        "abi": {
          "type": "string",
          "pattern": "^node-v[0-9]+$"
        }
      }
    },
    "minGlibc": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "minLibstdcxx": {
      "type": "string",
      "pattern": "^GLIBCXX_[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "packageLockSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payloadInventorySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stateCompatibility": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "buildTimestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
