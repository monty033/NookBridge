{
  "name": "nookbridge",
  "version": "0.1.2",
  "private": true,
  "description": "Stage 0 reproducible baseline for NookBridge, a headless Notesnook client. Application code is introduced in Stage 1.",
  "license": "GPL-3.0-or-later",
  "SPDX-License-Identifier": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.23.0 <23.0.0"
  },
  "main": "./dist/index.js",
  "bin": {
    "nook-mcp": "./dist/mcp/cli.js",
    "nookbridge-provision": "./dist/provision.js",
    "nookbridge-sync": "./dist/sync.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "artifact:linux": "bash scripts/build-linux-artifact.sh",
    "artifact:verify": "bash scripts/verify-linux-artifact.sh",
    "nookd": "node dist/nookd.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@notesnook/core": "8.1.3",
    "@notesnook/crypto": "2.1.3",
    "@streetwriters/kysely": "0.27.4",
    "better-sqlite3-multiple-ciphers": "11.5.0",
    "sqlite-better-trigram": "0.0.3",
    "sqlite-regex": "0.2.4-alpha.1",
    "sqlite3-fts5-html": "0.0.4"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "patch-package": "8.0.1",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
